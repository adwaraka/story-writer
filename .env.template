# Scene Editor settings. One file, used by both `docker compose` and `docker run --env-file`.
#
# RULES (so both tools read it the same way):
#   - Leave values UNQUOTED, even if they contain spaces.
#   - Put comments on their own line. Never after a value.
#   - Don't start a value with a quote character or include a # inside a value.

# --- Ollama (running natively on your Mac) ---
OLLAMA_HOST=http://host.docker.internal:11434
MODEL_NAME=hermes3

# --- Files (paths INSIDE the container; put your manuscript in ./data) ---
MANUSCRIPT_FILE=/data/novel.docx
OUTPUT_FILE=/data/scene_suggestions_patch.md

# --- Mode ---
# MODE=rewrite : improve the existing scene found between the anchors
# MODE=write   : write a NEW scene that opens with START_ANCHOR and closes with END_ANCHOR,
#                using the story before START_ANCHOR as context
MODE=rewrite
# CONTEXT_WORDS (write mode only): how many words of preceding story the model sees
CONTEXT_WORDS=6000

# --- Scene boundaries ---
# rewrite mode: must match the manuscript text exactly. write mode: can be brand-new sentences.
START_ANCHOR=<first statement>
END_ANCHOR=<first statement>

# --- Scene settings ---
# SCENE_TYPE: general, fight, romance
SCENE_TYPE=general
# DETAIL_LEVEL: 1 (restrained) to 4 (most explicit)
DETAIL_LEVEL=1
# TARGET_WORDS: rough length of the rewrite
TARGET_WORDS=1200
# MAX_OUTPUT_TOKENS: cap on generated tokens (~0.75 words each). Raise it if you raise TARGET_WORDS
MAX_OUTPUT_TOKENS=4096

# --- Styles (names from styles.json, or free text; comma-separate multiple) ---
GENRE=
FIGHT_STYLE=
ROMANCE_STYLE=<comma-separated>
TAGS=<comma-separated>